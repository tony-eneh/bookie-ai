DATABASE_URL=postgresql://bookieai:bookieai@localhost:5432/bookieai
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_DAYS=7
RESET_PASSWORD_EXPIRATION_MINUTES=30
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
FX_API_URL=https://api.exchangerate-api.com/v4/latest
CORS_MODE=strict
# Use permissive for preview/dev deployments and strict for production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=false
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Email goes through Resend from mail.joypinness.com, the domain verified there.
# The bare joypinness.com is the Lark mailboxes' domain and cannot be a sender.
RESEND_API_KEY=
MAIL_FROM=BookieAI <no-reply@mail.joypinness.com>
# Replies land in the shared Lark support inbox.
MAIL_REPLY_TO=support@joypinness.com
# SMTP is only used when RESEND_API_KEY is unset.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=
PORT=3000
